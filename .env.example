OPENAI_API_KEY=
OPENAI_MODEL=
# Use "mock" for offline placeholder results or "openai" for real API analysis.
AI_PROVIDER=mock
# Leave blank to use storage/scamshield.db and reports/ under the project root.
DATABASE_PATH=
REPORTS_DIR=
# Optional. When set, /api/v1 routes require this value in the X-API-Key header.
SCAMSHIELD_API_KEY=
# Used by the Streamlit workstation.
SCAMSHIELD_API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
# Comma-separated browser origins. Leave blank for the local workstation.
CORS_ORIGINS=
